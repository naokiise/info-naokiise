---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Header2D from "../components/Header2D.astro";
import { frontmatter } from "../data/works.md";
import type { WorkRow } from "../lib/types";
import { compositeFontHtml } from "../lib/typography";
import { getWorkId } from "../lib/slug";

// Sort works chronologically by year and filter out educational background
const works = frontmatter.works as (WorkRow & { section: string })[];
const filteredWorks = works.filter(work => work.section !== "Educational background");
const sortedWorks = [...filteredWorks].sort((a, b) => {
  const yearA = parseInt(a.year) || 0;
  const yearB = parseInt(b.year) || 0;
  return yearB - yearA; // Descending order (newest first)
});

// Timeline: group by year, newest first
const years = [...new Set(sortedWorks.map((w) => w.year))];
const byYear = years.map((year) => ({ year, works: sortedWorks.filter((w) => w.year === year) }));

// Month (1–12) from Notion "Date"; until it is filled in, a stable pseudo-random month from the title.
function monthOf(work: WorkRow & { month?: string }): number {
  const m = parseInt(work.month ?? "");
  if (m >= 1 && m <= 12) return m;
  let h = 0;
  for (const c of work.title) h = (h * 31 + c.charCodeAt(0)) >>> 0;
  return (h % 12) + 1;
}

// Helper function to get hostname from URL
function getHostname(url: string): string {
  try {
    return new URL(url).hostname;
  } catch {
    return url;
  }
}

// Get IDs of all works for client-side filtering
const allWorkIds = sortedWorks.map(getWorkId);

---

<Layout>
  <Navbar />
  <Header2D />
  <main class="content">
    <div class="timeline">
      {byYear.map((group) => (
        <section class="timeline__year">
          <h2 class="timeline__label font-inter">{group.year}</h2>
          <ul class="work-list timeline__list">
            {group.works.map((work) => (
              <li class={`work-item${work.image ? "" : " work-item--noimage"}`} data-work-id={getWorkId(work)} data-month={monthOf(work)} style={`--m:${monthOf(work)}`}>
                <div class="work-item__body">
                  <a class="work-item__title-link" href={`${import.meta.env.BASE_URL}work/${getWorkId(work)}/`}>
                    <p class="work-item__title" set:html={compositeFontHtml(work.title)} />
                  </a>
                  {work.text && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.text)} />
                  )}
                  {work.venue && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.venue)} />
                  )}
                  {work.publisher && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.publisher)} />
                  )}
                  {work.link && (
                    <p class="work-item__meta">
                      <a href={work.link} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        {getHostname(work.link)}
                      </a>
                    </p>
                  )}
                  {work.youtube && (
                    <p class="work-item__meta">
                      <a href={`https://youtube.com/watch?v=${work.youtube}`} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        YouTube
                      </a>
                    </p>
                  )}
                </div>
                {work.image ? (
                  <div class="work-item__image-container">
                    <img src={import.meta.env.BASE_URL + work.image.replace(/^\//, "")} alt={work.title} class="work-item__image" />
                  </div>
                ) : null}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .timeline {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .timeline__year {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }

  .timeline__label {
    margin: 0;
    padding-top: 8px;
    font-size: 12px;
    font-weight: 400;
    color: var(--text);
  }

  .timeline :global(.work-item) {
    border-bottom: none;
  }

  /* Each year is 12 months tall; December at the top, January at the bottom. */
  .timeline__list {
    --month-h: 28px;
    position: relative;
    margin: 0;
    min-height: calc(12 * var(--month-h));
  }

  .timeline__list :global(.work-item) {
    position: absolute;
    top: calc((12 - var(--m)) * var(--month-h));
    width: calc(50% - var(--column-spacing) / 2);
    margin: 0;
  }

  .timeline__list :global(.work-item.is-right) {
    left: calc(50% + var(--column-spacing) / 2);
  }

  @media (max-width: 768px) {
    .timeline__year {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .timeline__list :global(.work-item) {
      width: 100%;
    }
    .timeline__list :global(.work-item.is-right) {
      left: 0;
    }
  }
</style>

<script>
  // Place items by month, alternating left/right; push items down when they would overlap.
  function layoutTimeline() {
    const narrow = window.matchMedia("(max-width: 768px)").matches;
    document.querySelectorAll<HTMLElement>(".timeline__list").forEach((list) => {
      const items = [...list.querySelectorAll<HTMLElement>(".work-item")].sort(
        (a, b) => Number(b.dataset.month) - Number(a.dataset.month),
      );
      list.style.height = "";
      const bottoms = [0, 0];
      items.forEach((item, i) => {
        const col = narrow ? 0 : i % 2;
        item.classList.toggle("is-right", col === 1);
        item.style.marginTop = "0px";
        const top = item.offsetTop;
        const shift = Math.max(0, bottoms[col] - top);
        item.style.marginTop = `${shift}px`;
        bottoms[col] = top + shift + item.offsetHeight + 8;
      });
      list.style.height = `${Math.max(...bottoms, list.clientHeight)}px`;
    });
  }
  window.addEventListener("load", layoutTimeline);
  window.addEventListener("resize", layoutTimeline);
  document.fonts?.ready.then(layoutTimeline);
  layoutTimeline();
</script>
