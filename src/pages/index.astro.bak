---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Header2D from "../components/Header2D.astro";
import { frontmatter } from "../data/works.md";
import type { WorkRow } from "../lib/types";
import { compositeFontHtml } from "../lib/typography";
import { getWorkId } from "../lib/slug";

// Sort works chronologically by year and filter out educational background
const works = frontmatter.works as (WorkRow & { section: string })[];
const filteredWorks = works.filter(work => work.section !== "Educational background");
const sortedWorks = [...filteredWorks].sort((a, b) => {
  const yearA = parseInt(a.year) || 0;
  const yearB = parseInt(b.year) || 0;
  return yearB - yearA; // Descending order (newest first)
});

// Split works into two columns in zigzag pattern (left-right-left-right)
const column1 = sortedWorks.filter((_, index) => index % 2 === 0);
const column2 = sortedWorks.filter((_, index) => index % 2 === 1);

// Helper function to get hostname from URL
function getHostname(url: string): string {
  try {
    return new URL(url).hostname;
  } catch {
    return url;
  }
}

// Get IDs of all works for client-side filtering
const allWorkIds = sortedWorks.map(getWorkId);

// Add draggable attribute for reordering
const getDraggableClass = () => 'work-item--draggable';
---

<Layout>
  <Navbar />
  <Header2D />
  <main class="content">
    <div class="works-chronological" data-work-ids={allWorkIds.join(',')}>
      <div class="works-columns">
        <div class="works-column">
          <ul class="work-list">
            {column1.map((work) => (
              <li class="work-item work-item--draggable" data-work-id={getWorkId(work)} draggable="true">
                {work.image ? (
                  <div class="work-item__image-container">
                    <img src={import.meta.env.BASE_URL + work.image.replace(/^\//, "")} alt={work.title} class="work-item__image" />
                    <button class="work-item__replace-btn" aria-label="Replace image">Replace</button>
                    <input type="file" class="work-item__file-input" accept="image/*" data-work-id={getWorkId(work)} />
                  </div>
                ) : (
                  <div class="work-item__upload-area">
                    <button class="work-item__upload-btn" aria-label="Upload image">+</button>
                    <input type="file" class="work-item__file-input" accept="image/*" data-work-id={getWorkId(work)} />
                  </div>
                )}
                <div class="work-item__body">
                  <p class="work-item__category">{work.section}</p>
                  <p class="work-item__title" set:html={compositeFontHtml(work.title)} />
                  {work.text && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.text)} />
                  )}
                  {work.venue && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.venue)} />
                  )}
                  {work.publisher && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.publisher)} />
                  )}
                  {work.link && (
                    <p class="work-item__meta">
                      <a href={work.link} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        {getHostname(work.link)}
                      </a>
                    </p>
                  )}
                  {work.youtube && (
                    <p class="work-item__meta">
                      <a href={`https://youtube.com/watch?v=${work.youtube}`} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        YouTube
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="works-column">
          <ul class="work-list">
            {column2.map((work) => (
              <li class="work-item work-item--draggable" data-work-id={getWorkId(work)} draggable="true">
                {work.image ? (
                  <div class="work-item__image-container">
                    <img src={import.meta.env.BASE_URL + work.image.replace(/^\//, "")} alt={work.title} class="work-item__image" />
                    <button class="work-item__replace-btn" aria-label="Replace image">Replace</button>
                    <input type="file" class="work-item__file-input" accept="image/*" data-work-id={getWorkId(work)} />
                  </div>
                ) : (
                  <div class="work-item__upload-area">
                    <button class="work-item__upload-btn" aria-label="Upload image">+</button>
                    <input type="file" class="work-item__file-input" accept="image/*" data-work-id={getWorkId(work)} />
                  </div>
                )}
                <div class="work-item__body">
                  <p class="work-item__category">{work.section}</p>
                  <p class="work-item__title" set:html={compositeFontHtml(work.title)} />
                  {work.text && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.text)} />
                  )}
                  {work.venue && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.venue)} />
                  )}
                  {work.publisher && (
                    <p class="work-item__meta" set:html={compositeFontHtml(work.publisher)} />
                  )}
                  {work.link && (
                    <p class="work-item__meta">
                      <a href={work.link} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        {getHostname(work.link)}
                      </a>
                    </p>
                  )}
                  {work.youtube && (
                    <p class="work-item__meta">
                      <a href={`https://youtube.com/watch?v=${work.youtube}`} target="_blank" rel="noopener noreferrer" class="work-item__link">
                        YouTube
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Clear any previously stored removed works so works.md remains the single source of truth
    try {
      localStorage.removeItem('removed-works');
    } catch (e) {}

    const IMAGE_STORAGE_KEY = 'uploaded-images';
    const ORDER_STORAGE_KEY = 'works-order';
    const IMAGE_SIZES_KEY = 'image-sizes';
    const worksContainer = document.querySelector('.works-chronological');
    
    // Get uploaded images from localStorage
    const getUploadedImages = () => {
      try {
        const stored = localStorage.getItem(IMAGE_STORAGE_KEY);
        return stored ? JSON.parse(stored) : {};
      } catch (e) {
        return {};
      }
    };
    
    // Get custom order from localStorage
    const getCustomOrder = () => {
      try {
        const stored = localStorage.getItem(ORDER_STORAGE_KEY);
        return stored ? JSON.parse(stored) : null;
      } catch (e) {
        return null;
      }
    };
    
    // Save custom order to localStorage
    const saveCustomOrder = (order) => {
      try {
        localStorage.setItem(ORDER_STORAGE_KEY, JSON.stringify(order));
      } catch (e) {
        console.error('Failed to save custom order:', e);
      }
    };
    
    // Get image sizes from localStorage
    const getImageSizes = () => {
      try {
        const stored = localStorage.getItem(IMAGE_SIZES_KEY);
        return stored ? JSON.parse(stored) : {};
      } catch (e) {
        return {};
      }
    };
    
    // Save image size to localStorage
    const saveImageSize = (workId, width, height) => {
      try {
        const imageSizes = getImageSizes();
        imageSizes[workId] = { width, height };
        localStorage.setItem(IMAGE_SIZES_KEY, JSON.stringify(imageSizes));
      } catch (e) {
        console.error('Failed to save image size:', e);
      }
    };
    
    // Compress image before saving to localStorage
    const compressImage = (file, maxWidth = 800, quality = 0.7) => {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = (event) => {
          const img = new Image();
          img.src = event.target.result;
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;
            
            // Calculate new dimensions while maintaining aspect ratio
            if (width > maxWidth) {
              height = (height * maxWidth) / width;
              width = maxWidth;
            }
            
            canvas.width = width;
            canvas.height = height;
            
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            
            // Compress and convert to base64
            canvas.toBlob((blob) => {
              const reader = new FileReader();
              reader.readAsDataURL(blob);
              reader.onload = (e) => resolve(e.target.result);
              reader.onerror = reject;
            }, 'image/jpeg', quality);
          };
          img.onerror = reject;
        };
        reader.onerror = reject;
      });
    };
    
    // Save uploaded image to localStorage
    const saveUploadedImage = (workId, imageData) => {
      try {
        const uploadedImages = getUploadedImages();
        uploadedImages[workId] = imageData;
        localStorage.setItem(IMAGE_STORAGE_KEY, JSON.stringify(uploadedImages));
      } catch (e) {
        console.error('Failed to save uploaded image:', e);
        alert('Image too large for localStorage storage. Try a smaller image or compress it first.');
      }
    };
    
    // Apply custom order if it exists (commented out to always use chronological order)
    // const customOrder = getCustomOrder();
    // if (customOrder && customOrder.length > 0) {
    //   const allWorkItems = Array.from(document.querySelectorAll('.work-item'));
    //   const orderedItems = customOrder.map(id => allWorkItems.find(item => item.getAttribute('data-work-id') === id)).filter(Boolean);
    //   
    //   if (orderedItems.length > 0) {
    //     const column1List = document.querySelector('.works-column:first-child .work-list');
    //     const column2List = document.querySelector('.works-column:last-child .work-list');
    //     
    //     if (column1List && column2List) {
    //       // Clear current items
    //       column1List.innerHTML = '';
    //       column2List.innerHTML = '';
    //       
    //       // Redistribute items in zigzag pattern
    //       orderedItems.forEach((item, index) => {
    //         if (index % 2 === 0) {
    //           column1List.appendChild(item);
    //         } else {
    //           column2List.appendChild(item);
    //         }
    //       });
    //     }
    //   }
    // }
    
    // Display uploaded images
    const displayUploadedImages = () => {
      const uploadedImages = getUploadedImages();
      Object.entries(uploadedImages).forEach(([workId, imageData]) => {
        const workItem = document.querySelector(`[data-work-id="${workId}"]`);
        if (workItem) {
          const uploadArea = workItem.querySelector('.work-item__upload-area');
          const existingContainer = workItem.querySelector('.work-item__image-container');
          const existingImg = workItem.querySelector('.work-item__image');
          
          if (uploadArea) {
            // Create image container with replace functionality
            const container = document.createElement('div');
            container.className = 'work-item__image-container';
            
            const img = document.createElement('img');
            img.src = imageData;
            img.alt = workItem.querySelector('.work-item__title').textContent;
            img.className = 'work-item__image';
            
            const replaceBtn = document.createElement('button');
            replaceBtn.className = 'work-item__replace-btn';
            replaceBtn.setAttribute('aria-label', 'Replace image');
            replaceBtn.textContent = 'Replace';
            
            const fileInput = document.createElement('input');
            fileInput.type = 'file';
            fileInput.className = 'work-item__file-input';
            fileInput.accept = 'image/*';
            fileInput.setAttribute('data-work-id', workId);
            
            container.appendChild(img);
            container.appendChild(replaceBtn);
            container.appendChild(fileInput);
            uploadArea.replaceWith(container);
            
            // Observe new container for resize events
            resizeObserver.observe(container);
          } else if (existingImg) {
            // Update existing image with uploaded/replaced image
            existingImg.src = imageData;
            
            // Make sure the existing container has the replace button if it doesn't already
            if (!existingContainer.querySelector('.work-item__replace-btn')) {
              const replaceBtn = document.createElement('button');
              replaceBtn.className = 'work-item__replace-btn';
              replaceBtn.setAttribute('aria-label', 'Replace image');
              replaceBtn.textContent = 'Replace';
              
              const fileInput = document.createElement('input');
              fileInput.type = 'file';
              fileInput.className = 'work-item__file-input';
              fileInput.accept = 'image/*';
              fileInput.setAttribute('data-work-id', workId);
              
              existingContainer.appendChild(replaceBtn);
              existingContainer.appendChild(fileInput);
              
              // Re-attach event listeners
              handleFileUpload(fileInput);
              setupDragDrop(existingContainer);
              resizeObserver.observe(existingContainer);
            }
          }
        }
      });
    };
    
    // Display uploaded images immediately on page load
    displayUploadedImages();
    
    // Restore image sizes from localStorage
    const imageSizes = getImageSizes();
    Object.entries(imageSizes).forEach(([workId, size]) => {
      const workItem = document.querySelector(`[data-work-id="${workId}"]`);
      if (workItem) {
        const container = workItem.querySelector('.work-item__image-container');
        if (container) {
          container.style.width = size.width;
          container.style.height = size.height;
        }
      }
    });
    
    // Save image sizes when resized
    const resizeObserver = new ResizeObserver((entries) => {
      entries.forEach(entry => {
        const container = entry.target;
        const workItem = container.closest('.work-item');
        if (workItem) {
          const workId = workItem.getAttribute('data-work-id');
          if (workId) {
            const width = container.style.width || 'auto';
            const height = container.style.height || 'auto';
            saveImageSize(workId, width, height);
          }
        }
      });
    });
    
    // Observe all image containers for resize events
    document.querySelectorAll('.work-item__image-container').forEach(container => {
      resizeObserver.observe(container);
    });
    
    // Handle image uploads
    const uploadButtons = document.querySelectorAll('.work-item__upload-btn');
    
    uploadButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const fileInput = button.nextElementSibling;
        if (fileInput) {
          fileInput.click();
        }
      });
    });
    
    // Handle replace button clicks
    const replaceButtons = document.querySelectorAll('.work-item__replace-btn');
    
    replaceButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fileInput = button.nextElementSibling;
        if (fileInput) {
          fileInput.click();
        }
      });
    });
    
    const fileInputs = document.querySelectorAll('.work-item__file-input');
    
    const setupDragDrop = (element) => {
      // Prevent default drag behaviors
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        element.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
        });
      });
      
      // Highlight drop area
      ['dragenter', 'dragover'].forEach(eventName => {
        element.addEventListener(eventName, () => {
          element.classList.add('drag-over');
        });
      });
      
      // Remove highlight
      ['dragleave', 'drop'].forEach(eventName => {
        element.addEventListener(eventName, () => {
          element.classList.remove('drag-over');
        });
      });
      
      // Handle dropped files
      element.addEventListener('drop', async (e) => {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          const file = files[0];
          if (file.type.startsWith('image/')) {
            const workId = element.querySelector('.work-item__file-input').getAttribute('data-work-id');
            
            try {
              // Compress image before processing
              const imageData = await compressImage(file);
              saveUploadedImage(workId, imageData);
              
              // Update existing image or create new container
              const img = element.querySelector('.work-item__image');
              if (img) {
                img.src = imageData;
                // Save the replaced image to localStorage
                saveUploadedImage(workId, imageData);
              } else {
                // Create new image container
                const newContainer = document.createElement('div');
                newContainer.className = 'work-item__image-container';
                
                const newImg = document.createElement('img');
                newImg.src = imageData;
                newImg.alt = element.closest('.work-item').querySelector('.work-item__title').textContent;
                newImg.className = 'work-item__image';
                
                const replaceBtn = document.createElement('button');
                replaceBtn.className = 'work-item__replace-btn';
                replaceBtn.setAttribute('aria-label', 'Replace image');
                replaceBtn.textContent = 'Replace';
                
                const fileInput = element.querySelector('.work-item__file-input');
                const newFileInput = fileInput.cloneNode(true);
                fileInput.remove();
                
                newContainer.appendChild(newImg);
                newContainer.appendChild(replaceBtn);
                newContainer.appendChild(newFileInput);
                element.replaceWith(newContainer);
                
                // Re-attach event listeners
                handleFileUpload(newFileInput);
                setupDragDrop(newContainer);
                resizeObserver.observe(newContainer);
              }
            } catch (error) {
              console.error('Error processing dropped image:', error);
              alert('Failed to process image. Please try a smaller image.');
            }
          } else {
            alert('Please drop an image file');
          }
        }
      });
    };
    
    const handleFileUpload = (input) => {
      input.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (file) {
          const workId = input.getAttribute('data-work-id');
          
          try {
            // Compress image before processing
            const imageData = await compressImage(file);
            saveUploadedImage(workId, imageData);
            
            // Replace existing image or upload area
            const container = input.closest('.work-item__image-container') || input.closest('.work-item__upload-area');
            if (container) {
              const img = container.querySelector('.work-item__image');
              if (img) {
                img.src = imageData;
                // Already saved above via saveUploadedImage
              } else {
                // Create new image container
                const newContainer = document.createElement('div');
                newContainer.className = 'work-item__image-container';
                
                const newImg = document.createElement('img');
                newImg.src = imageData;
                newImg.alt = input.closest('.work-item').querySelector('.work-item__title').textContent;
                newImg.className = 'work-item__image';
                
                const replaceBtn = document.createElement('button');
                replaceBtn.className = 'work-item__replace-btn';
                replaceBtn.setAttribute('aria-label', 'Replace image');
                replaceBtn.textContent = 'Replace';
                
                // Move the file input to new container
                const newFileInput = input.cloneNode(true);
                input.remove();
                
                newContainer.appendChild(newImg);
                newContainer.appendChild(replaceBtn);
                newContainer.appendChild(newFileInput);
                container.replaceWith(newContainer);
                
                // Re-attach event listeners
                handleFileUpload(newFileInput);
                setupDragDrop(newContainer);
                resizeObserver.observe(newContainer);
              }
            }
          } catch (error) {
            console.error('Error processing image:', error);
            alert('Failed to process image. Please try a smaller image.');
          }
        }
      });
    };
    
    fileInputs.forEach(handleFileUpload);
    
    // Handle drag and drop
    const uploadAreas = document.querySelectorAll('.work-item__upload-area');
    
    uploadAreas.forEach(setupDragDrop);
    document.querySelectorAll('.work-item__image-container').forEach(setupDragDrop);
    
    // Observe image containers for resize events
    document.querySelectorAll('.work-item__image-container').forEach(container => {
      resizeObserver.observe(container);
    });
    
    // Handle drag and drop for reordering projects
    let draggedItem = null;
    
    // Set up drag and drop with event delegation
    document.addEventListener('dragstart', (e) => {
      const target = e.target.closest('.work-item--draggable');
      if (target) {
        draggedItem = target;
        setTimeout(() => draggedItem.classList.add('dragging'), 0);
        e.dataTransfer.effectAllowed = 'move';
      }
    });
    
    document.addEventListener('dragend', (e) => {
      if (draggedItem) {
        draggedItem.classList.remove('dragging');
        draggedItem = null;
        
        // Redistribute items in zigzag pattern after drag
        redistributeItems();
        
        // Restore uploaded images after redistribution
        displayUploadedImages();
        
        // Save new order
        const allItems = Array.from(document.querySelectorAll('.work-item'));
        const newOrder = allItems.map(item => item.getAttribute('data-work-id'));
        saveCustomOrder(newOrder);
      }
    });
    
    document.addEventListener('dragover', (e) => {
      const target = e.target.closest('.work-item--draggable');
      if (target && draggedItem && draggedItem !== target) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        
        const rect = target.getBoundingClientRect();
        const midY = rect.top + rect.height / 2;
        
        if (e.clientY < midY) {
          target.parentNode.insertBefore(draggedItem, target);
        } else {
          target.parentNode.insertBefore(draggedItem, target.nextSibling);
        }
      }
    });
    
    document.addEventListener('drop', (e) => {
      e.preventDefault();
    });
    
    // Helper function to redistribute items in zigzag pattern
    const redistributeItems = () => {
      const allItems = Array.from(document.querySelectorAll('.work-item'));
      const column1List = document.querySelector('.works-column:first-child .work-list');
      const column2List = document.querySelector('.works-column:last-child .work-list');
      
      if (column1List && column2List) {
        column1List.innerHTML = '';
        column2List.innerHTML = '';
        
        allItems.forEach((item, index) => {
          if (index % 2 === 0) {
            column1List.appendChild(item);
          } else {
            column2List.appendChild(item);
          }
        });
      }
    };
  });
</script>
