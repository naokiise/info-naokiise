<button id="theme-toggle" class="navbar__text-toggle" type="button" aria-label="テーマ切替">light</button>

<script>
  const html = document.documentElement;
  const btn = document.getElementById("theme-toggle");

  // Shows the current mode as text: "light" / "dark"
  function syncLabel() {
    const isDark = html.classList.contains("theme-dark");
    if (btn) {
      btn.textContent = isDark ? "dark" : "light";
      btn.setAttribute("aria-label", isDark ? "ライトモードに切り替え" : "ダークモードに切り替え");
    }
  }

  syncLabel();

  btn?.addEventListener("click", () => {
    const nextDark = !html.classList.contains("theme-dark");
    html.classList.remove("theme-light", "theme-dark");
    html.classList.add(nextDark ? "theme-dark" : "theme-light");
    try {
      localStorage.setItem("color-preference", nextDark ? "dark" : "light");
    } catch {}
    syncLabel();
  });
</script>
